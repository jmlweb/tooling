{
  "name": "jmlweb-tooling",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "ci": "pnpm validate && pnpm build",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev": "turbo run dev",
    "dev:docs": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "docs:generate": "pnpm --filter docs generate:docs",
    "docs:preview": "pnpm --filter docs preview",
    "format": "oxfmt \"**/*.{js,ts,tsx,json,md}\"",
    "format:check": "oxfmt --check \"**/*.{js,ts,tsx,json,md}\"",
    "integration:test": "pnpm --filter @jmlweb/integration-tests test",
    "lint": "turbo run lint",
    "lint:root": "oxlint --disable-nested-config --ignore-pattern 'packages/*/src/**'",
    "prepare": "husky",
    "syncpack:check": "syncpack lint",
    "syncpack:fix": "syncpack fix && syncpack format",
    "test": "turbo run test",
    "validate": "turbo run format:check lint:root lint && pnpm syncpack:check",
    "validate:code-blocks": "node scripts/validate-markdown-code-blocks.mjs",
    "validate:code-blocks:fix": "node scripts/validate-markdown-code-blocks.mjs --fix",
    "validate:docs": "node scripts/validate-docs.mjs",
    "validate:docs:fix": "node scripts/fix-markdown-code-blocks.mjs",
    "validate:packages": "node scripts/validate-all-packages.mjs",
    "version": "changeset version",
    "version:prerelease": "changeset version --snapshot prerelease",
    "version:snapshot": "changeset version --snapshot"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@jmlweb/eslint-config-base-js": "workspace:*",
    "@jmlweb/oxfmt-config-base": "workspace:*",
    "@jmlweb/oxlint-config-base": "workspace:*",
    "@jmlweb/prettier-config-base": "workspace:*",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "syncpack": "^15.3.3",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "oxlint --fix --disable-nested-config",
      "oxfmt"
    ],
    "*.{ts,tsx}": [
      "oxfmt"
    ],
    "package.json": [
      "oxfmt"
    ],
    "*.json": [
      "oxfmt"
    ],
    "*.md": [
      "oxfmt"
    ]
  },
  "packageManager": "pnpm@10.26.2",
  "private": true,
  "workspaces": [
    "packages/*"
  ]
}
