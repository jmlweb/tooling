{
  "name": "@jmlweb/eslint-config-node",
  "version": "3.0.1",
  "description": "ESLint configuration for Node.js projects with TypeScript, extending base config with Node.js-specific rules",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "lint": "oxlint -c ../../oxlint.config.ts src",
    "prepublishOnly": "node ../../scripts/validate-package.mjs && pnpm build"
  },
  "keywords": [
    "code-quality",
    "eslint",
    "eslint-config",
    "linting",
    "node",
    "nodejs",
    "typescript"
  ],
  "author": "jmlweb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmlweb/tooling.git"
  },
  "bugs": "https://github.com/jmlweb/tooling/issues",
  "homepage": "https://github.com/jmlweb/tooling/tree/main/packages/eslint-config-node#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@eslint/js": "^9.0.0 || ^10.0.0",
    "@jmlweb/eslint-config-base": "workspace:^",
    "eslint": "^9.0.0 || ^10.0.0",
    "eslint-config-prettier": "^9.1.0 || ^10.0.0",
    "eslint-plugin-n": "^17.0.0 || ^18.0.0",
    "eslint-plugin-simple-import-sort": "^12.0.0 || ^13.0.0 || ^14.0.0",
    "globals": "^15.0.0 || ^16.0.0 || ^17.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "@jmlweb/eslint-config-base": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jmlweb/eslint-config-base": "workspace:*",
    "@jmlweb/tsconfig-internal": "workspace:*",
    "@jmlweb/tsdown-config-base": "workspace:*",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "tsdown": "~0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
