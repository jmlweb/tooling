{
  "name": "nodejs-typescript-api-example",
  "version": "1.0.0",
  "description": "Example Node.js TypeScript API using @jmlweb tooling packages",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jmlweb/eslint-config-base": "workspace:*",
    "@jmlweb/prettier-config-base": "workspace:*",
    "@jmlweb/tsconfig-base": "workspace:*",
    "@jmlweb/vitest-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "prettier": "@jmlweb/prettier-config-base",
  "engines": {
    "node": ">=22.12.0"
  }
}
