{
  "name": "nodejs-typescript-api-example",
  "version": "1.0.0",
  "private": true,
  "description": "Example Node.js TypeScript API using @jmlweb tooling packages",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@jmlweb/oxfmt-config-base": "workspace:*",
    "@jmlweb/oxlint-config-node": "workspace:*",
    "@jmlweb/tsconfig-base": "workspace:*",
    "@jmlweb/vitest-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint-plugin-n": "^18.5.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "prettier": "@jmlweb/prettier-config-base",
  "engines": {
    "node": ">=22.12.0"
  }
}
