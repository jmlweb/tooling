{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["src/**", "tsdown.config.ts", "tsconfig.json", "package.json"]
    },
    "lint": {
      "dependsOn": ["^build", "@jmlweb/oxlint-config-base#build"],
      "outputs": [],
      "inputs": [
        "src/**",
        "*.{js,mjs,cjs,ts,tsx,jsx}",
        "eslint.config.*",
        "tsconfig.json",
        "package.json",
        "$TURBO_ROOT$/oxlint.config.ts",
        "$TURBO_ROOT$/packages/tsconfig-internal/tsconfig.json"
      ]
    },
    "//#lint:root": {
      "dependsOn": ["@jmlweb/oxlint-config-base#build"]
    },
    "//#format:check": {
      "dependsOn": ["@jmlweb/oxfmt-config-base#build"]
    },
    "format": {
      "outputs": [],
      "inputs": ["**/*.{js,json,md}", "oxfmt.config.ts", "package.json"]
    },
    "clean": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": [
        "src/**",
        "fixtures/**",
        "scripts/**",
        "*.test.*",
        "*.spec.*",
        "vitest.config.*",
        "jest.config.*",
        "package.json"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate:docs": {
      "dependsOn": ["^build"],
      "outputs": ["src/content/docs/**/*.mdx"],
      "inputs": [
        "../../packages/*/README.md",
        "../../packages/*/package.json",
        "scripts/generate-docs.mjs"
      ]
    }
  }
}
