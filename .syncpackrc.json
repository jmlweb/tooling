{
  "$schema": "https://unpkg.com/syncpack/dist/schema.json",
  "formatRepository": false,
  "sortFirst": [
    "name",
    "version",
    "description",
    "type",
    "main",
    "module",
    "types",
    "exports",
    "files",
    "scripts",
    "keywords",
    "author",
    "license",
    "repository",
    "bugs",
    "homepage",
    "engines",
    "publishConfig",
    "peerDependencies",
    "peerDependenciesMeta",
    "dependencies",
    "devDependencies"
  ],
  "versionGroups": [
    {
      "label": "Ignore workspace protocol references",
      "dependencies": ["@jmlweb/**"],
      "specifierTypes": ["workspace"],
      "isIgnored": true
    },
    {
      "label": "Ignore peer dependency ranges (intentionally broader for compatibility)",
      "dependencyTypes": ["peer"],
      "isIgnored": true
    },
    {
      "label": "eslint-plugin-react does not support ESLint 10 yet (its 'detect' version setting crashes), so the React example app runs ESLint 9. The React config package itself is built against ESLint 10 to share one plugin instance with the base config",
      "dependencies": ["eslint", "@eslint/js"],
      "packages": ["react-typescript-app-example"],
      "pinVersion": "^9.39.4"
    },
    {
      "label": "Ensure consistent versions for all other dependencies",
      "dependencies": ["**"],
      "dependencyTypes": ["dev", "prod"]
    }
  ],
  "semverGroups": [
    {
      "label": "Use caret ranges for dev and prod dependencies",
      "range": "^",
      "dependencyTypes": ["dev", "prod"]
    }
  ]
}
